import { generateCanvasFromPDF } from './generateCanvasFromPDF';
import * as pdfjsLib from 'pdfjs-dist';

jest.mock('pdfjs-dist', () => {
  const renderMock = jest.fn(() => ({
    promise: Promise.resolve(),
  }));

  const getPageMock = jest.fn().mockResolvedValue({
    getViewport: jest.fn(() => ({
      width: 600,
      height: 800,
    })),
    render: renderMock,
  });

  return {
    getDocument: jest.fn(() => ({
      promise: Promise.resolve({
        numPages: 1,
        getPage: getPageMock,
      }),
    })),
  };
});

describe('generateCanvasFromPDF', () => {
  it('should return an array of canvas elements for a valid base64 PDF', async () => {
    const dummyBase64 = btoa('%PDF-1.4...'); // This is a dummy string, not a real PDF

    const canvases = await generateCanvasFromPDF(dummyBase64);

    expect(pdfjsLib.getDocument).toHaveBeenCalled();
    expect(Array.isArray(canvases)).toBe(true);
    expect(canvases.length).toBe(1);
    expect(canvases[0] instanceof HTMLCanvasElement).toBe(true);
  });
});
