    componentDidMount() {
        if (this.state.source === 'Pre/Back order' && !isNullOrEmpty(this.state.confirmationNo)) this.handleClickEvent();
    }

    showTrackShipment = () => {
        this.setState({ showFFLTrackingInfo: true });
    };

    buildTrackingNumberUrl = (carrier, trackingNo) => {
        if (isNullOrEmpty(carrier) || isNullOrEmpty(trackingNo)) return <span dangerouslySetInnerHTML={{ __html: 'No Tracking Data Available' }} />;
        let trackingUrl = '';
        if (trackingNo?.length > 0 && !isNullOrEmpty(carrier)) {
            if (/ups/gi.test(carrier)) trackingUrl = UPS_TRACKING_URL;
            else if (/fed/gi.test(carrier)) trackingUrl = FEDEX_TRACKING_URL;
            else if (/usps|ECONOMYSHP/gi.test(carrier)) trackingUrl = USPS_TRACKING_URL;
            else if (/A1/gi.test(carrier)) trackingUrl = A1_TRACKING_URL;
            else if (/deliv|SDD|SAMEDAY|SDD_SAMEDAY/gi.test(carrier)) trackingUrl = DELIV_TRACKING_URL;
            else trackingUrl = '';

            let carrierTracking = carrier + '_' + trackingNo;
            if (!isNullOrEmpty(trackingUrl)) {
                trackingUrl = trackingUrl.replace('{trackingNum}', trackingNo);
                carrierTracking = carrierTracking.replace(carrierTracking, `<a target="_blank" className="blueanchor" href='${trackingUrl}'>${carrierTracking}</a>`);
            } else {
                carrierTracking = carrierTracking.replace(carrierTracking, `<a target="_blank"'>${carrier}_${trackingNo}_No Tracking Data Available</a>`);
            }

            return (
                <>
                    <span dangerouslySetInnerHTML={{ __html: carrierTracking }} />
                </>
            );
        } else {
            return (
                <>
                    <span dangerouslySetInnerHTML={{ __html: 'No Tracking Data Available' }} />
                </>
            );
        }
    };

    handleViewData = (val, obj) => {
        if (val === 'preorderdetails') {
            this.setState({ showPrebackOrderDetails: false });
            return;
        }

        if (this.state.showRsaTokenValidation && this.state.orderLocationTabClicked) {
            if (this.state.showRsaTokenValidation && val === 'rsaTokenValidation') {
                this.setState({
                    showRsaTokenValidation: false,
                    orderLocationTabClicked: false,
                });
            }

            return;
        }

        if (this.state.showRsaSuccess && val === 'rsaTokenSuccess') {
            this.setState({ showRsaSuccess: false });
            return;
        }

        const { order } = this.props.order;
        const { selectedRow = 0 } = this.state;
        if (!!obj) {
            this.setState({ orderNumber: obj.orderNumber, uswinLocation: obj.location, selectedRow: obj.indexkey }, () => {
                console.log('order state updated');
            });
        }
        let callApi = false;
        const staticObj = { showOrderDetails: false, showOrderPreview: false, showRemarks: false };
        if (val === 'remarks') {
            if (!this.state.showRemarks) {
                callApi = true;
                this.setState({ ...staticObj, showRemarks: true });
            } else {
                this.setState({ ...staticObj, showOrderDetails: true });
            }

            if (this.state.showRemarks) {
                this.setState({ showFFLTrackingInfo: false });
            }
        } else {
            if (!this.state.showOrderPreview) {
                callApi = true;
                this.setState({ ...staticObj, showOrderPreview: true });
            } else {
                this.setState({ ...staticObj, showOrderDetails: true });
            }
        }

        if (order?.length && callApi && val === 'remarks') {
            const billAcctNum = order[selectedRow].billAcctNum;
            this.props.loadUsiwnOrderPreviewReq({
                orderNum: !!obj ? obj.orderNumber : this.state.orderNumber,
                locationCode:
                    this.state.searchBy === 'Paypal' || this.state.searchBy === 'Device ID' || this.state.searchBy === 'Credit card number'
                        ? order[selectedRow]?.locationCode
                        : !!obj
                        ? obj.location
                        : this.state.uswinLocation,
                orderType: this.state.orderType === 'Other(CP)' ? 'CP' : this.state.orderType,
                mobileNumber: order[selectedRow].mobileNumber,
                accountNumber: order[selectedRow].accountNumber,
                billAcctNum: billAcctNum > 9 ? `000${billAcctNum}` : `0000${billAcctNum}`,
            });
        }
    };

    expandCollapse = () => {
        const { isExpand } = this.state;
        this.setState({
            isExpand: !isExpand,
            isBelow: true,
        });
    };

    shouldComponentUpdate(nextProps, nextState) {
        const uswin = nextProps.orderSearchState && nextProps.orderSearchState.uswin ? nextProps.orderSearchState.uswin : nextProps.userId;
        if (!isEqual(this.props.userId, nextProps.userId)) {
            if (nextProps.userId) {
                if (nextProps.userId.length > 0) {
                    this.setState(
                        {
                            uswin: uswin,
                            isDisable: uswin.length > 0 ? false : true,
                        },
                        () => {
                            this.forceUpdate();
                        }
                    );
                }
            }
        }
        if (!isEqual(this.props.order.order, nextProps.order.order)) {
            if (nextProps.order.order) {
                if (nextProps.order.order.length === 1 || nextProps.order.order.length > 1) {
                    this.setState({ selectedRow: 0 });
                }

                // initially expand on order data populate for small screens.
                // customer can play with expand/collapse using arrow icon(on click event which handles collapse)
                if (nextProps.order.order.length >= 1 && this.props.order.order.length === 0 && window.outerHeight < 1080) {
                    this.expandCollapse();
                }
            }
        }

        return true;
    }

    componentDidUpdate(prevProps) {
        const { prebackSuccess } = this.props.preback;
        const cpqcartDetailsobj = { cpqCartId: '', cpqCartVersionId: '' };
        if (this.props.b360Order !== prevProps.b360Order) {
            const orderRes = this.props.b360Order;
            const { orderNumber, orderLocation, cpqcartDetails = {} } = !isEmpty(orderRes) && orderRes; // cPQCartDetails
            const { cpqCartId = '', cpqCartVersionId = '' } = !isEmpty(cpqcartDetails) ? cpqcartDetails : cpqcartDetailsobj;
            const { cartId } = !isEmpty(orderRes) && orderRes;
            const url = CUSTOMER_360_PATH;
            let nextScreenName = 'cust360_search';
            const channelId = 'OMNI-CARE';
            const reqUrl = {
                nextScreen: url,
                cust360: true,
                name: nextScreenName,
                source: 'ordersearch',
            };
            const cust360Req = {
                header: {},
                ignoreCache: false,
                optionalLoginUserDetails: {
                    CART_ID: cpqCartId || cartId,
                    MODULE_NAME: 'SHOP',
                    LOCATION_CODE: orderLocation,
                    ORDER_NUMBER: orderNumber,
                    ACCOUNT_NUMBER: '',
                    SYSTEM_ID: 'ACSS',
                    IS_SOE: true,
                    CART_VERSION_ID: cpqCartVersionId,
                    COSTCO_B360_FLOW: false,
                    SALES_REPID: orderRes.repId,
                    LAUNCHED_FROM: 'VIEW_ORDER_B360',
                    salesRepId: orderRes.repId,
                    wfhStatus: true,
                    VISITOR_ID: 'T42169476',
                    IS_RFEX_FLOW: false,
                },
            };

            this.props.updateUserParam({ cust360Req, reqUrl, channelId });
        }

        if (this.props.updatedUserParam !== prevProps.updatedUserParam) {
            if (this.props.updatedUserParam && this.props.updatedUserParam.data && this.props.userParam.reqUrl && /ordersearch/i.test(this.props.userParam.reqUrl.source)) {
                // check successful/data
                const reqSuccess = this.props.updatedUserParam && this.props.updatedUserParam.data && this.props.updatedUserParam.data.status == '1' ? true : false;
                const reqData = this.props.userParam && this.props.userParam.reqUrl ? this.props.userParam.reqUrl : null;
                // check b360 vs cust360 (and advancedSearch)
                const isb360Quote = reqSuccess && reqData && reqData.b360quote ? true : false;

                // set tab name/url
                let screenName = isb360Quote ? 'order' : 'account';
                let url = isb360Quote ? B360_QUOTE_PATH : CUSTOMER_360_PATH;
                url = reqData.b2bOrderDetails ? reqData.nextScreen : url;

                const isb360Bulk = reqSuccess && reqData && reqData.b360bulk ? true : false;
                if (isb360Bulk) {
                    screenName = 'order';
                    url = B360_BULK_PATH;
                }

                const b2bOrderDetailsVal = reqData.b2bOrderDetails ? 'B2B_ORDERDETAILS' : 'CUST360';
                refreshSession(`LP_${isb360Quote ? 'B360' : b2bOrderDetailsVal}_SEARCH`, true);

                if (isIpad()) {
                    let shellParams = {
                        name: screenName,
                        path: '',
                        replace: 'true',
                        params: `rawurl:${url}`,
                    };
                    //   this.props.executeShellFunction('Shell', 'showScreen', 'none', shellParams);
                } else {
                    // redirect URL on desktop
                    window.open(DOMPurify.sanitize(url), '_blank');
                }
            } else if (this.props.updatedUserParam?.data && /orderstatustracker/i.test(this.props.userParam?.reqUrl?.source)) {
                this.setState({ isLoading: false });
                try {
                    const reqSuccess = this.props.updatedUserParam?.data?.status == '1' ? true : false;
                    const screenName = 'order';
                    let url = ORDER_STATUS_TRACKER;
                    if (reqSuccess === true) {
                        if (isIpad()) {
                            let shellParams = {
                                name: screenName,
                                path: '',
                                replace: 'true',
                                params: `rawurl:${url}`,
                            };
                            this.props.executeShellFunction('Shell', 'showScreen', 'none', shellParams);
                        } else {
                            // redirect URL on desktop
                            if (inIframe()) {
                                const message = {
                                    iframe: screenName,
                                    path: '',
                                    replace: true,
                                    url: url,
                                    //url: URL
                                };
                                let target = window.parent;
                                target.postMessage(message, POSTMESSAGE_ORIGIN);
                            } else {
                                window.open(DOMPurify.sanitize(url), '_blank');
                            }
                        }
                    }
                } catch (e) {
                    this.props.addAppMessage(`Problem with Order Status Tracker Navigation`, 'warning', true, true);
                }
            }
        }

        if (this.props.order.salesRepOrderDetails !== prevProps.order.salesRepOrderDetails) {
            const { salesRepOrderDetails = [] } = this.props.order;
            const aceOrderTelRepLocSearchDetailsList = !isEmpty(salesRepOrderDetails) && salesRepOrderDetails.aceOrderTelRepLocSearchDetailsList;
            if (/sales id/i.test(this.state.searchBy)) {
                this.setState({
                    selectedRow: 0,
                    orderNumber: !isEmpty(aceOrderTelRepLocSearchDetailsList) && aceOrderTelRepLocSearchDetailsList[0].orderNum,
                });
            }
        }

        if (this.props.cookieInfo !== prevProps.cookieInfo) {
            if (this.props.cookieInfo && this.props.cookieInfo.url) {
                const { url, soeguivalue, soeguisubkey } = this.props.cookieInfo;
                let readOrderUrl = url;
                if (soeguivalue && soeguisubkey) {
                    readOrderUrl = readOrderUrl + '&nsasoeguivalue=' + soeguivalue + '&nsasoeguisubkey=' + soeguisubkey;
                }
                if (isIpad()) {
                    let shellParams = {
                        name: 'order',
                        path: '',
                        replace: 'true',
                        params: `rawurl:${url}`,
                    };
                    this.props.executeShellFunction('Shell', 'showScreen', 'none', shellParams);
                } else {
                    // close order tab if open
                    if (window?.parent?.orderTabOpened?.closed) {
                        window.parent.orderTabOpened.close();
                    }

                    // open new order tab with new jwt
                    const soeguisubkey = sessionStorage.getItem('nsasoeguisubkey');
                    const soeguivalue = sessionStorage.getItem('nsasoeguivalue');
                    let soeSubkey = sessionStorage.getItem('soeguisubkey');
                    soeSubkey = soeSubkey && soeSubkey.substring(0, 15);
                    let nsaOrderUrl = url;
                    if (soeguisubkey && soeguivalue) {
                        nsaOrderUrl += `&nsasoeguisubkey=${soeguisubkey}`;
                        nsaOrderUrl += `&nsasoeguivalue=${soeguivalue}`;
                    }
                    window.parent.orderTabOpened = window.open(DOMPurify.sanitize(nsaOrderUrl), soeSubkey, 'toolbar=yes,scrollbars=yes,resizable=yes,top=50,left=100,width=1000,height=800');
                }
            }
        }
        //Original order search from orderpreview
        if (this.props.originalOrderDetailsData) {
            const { orderNumber, orderLocation } = this.props.originalOrderDetailsData;
            this.setState({
                searchBy: 'Order',
                searchOrderBy: 'Order number',
                orderNumber: orderNumber,
                locationCode: orderLocation,
            });
            setTimeout(() => this.handleClickEvent());
            this.props.retriveOriginalOrder();
        }

        if (prebackSuccess) {
            //not in use, hence commenting
            // this.handleCloseModify();
            this.props.prebackReset();
        }

        // If parameters are found in the store, we can open specific search types on mount.
        if (prevProps.openDefaultSearch !== this.props.openDefaultSearch)
            if (this.props.openDefaultSearch?.type) {
                this.setState({ searchBy: this.props.openDefaultSearch.type, showResults: true });
            }
        if (prevProps.locationCode !== this.props.locationCode && this.props.locationCode && !this.state.uswinLocation) {
            this.setState({ uswinLocation: this.props.locationCode });
        }

        if (prevProps.order.globalLocation !== this.props.order.globalLocation) {
            this.setState({ showRsaTokenValidation: this.shouldShowGlobalLocation(this.props.order.globalLocation), showOrderPreview: false });
        }

        if (this.state.showRsaTokenValidation && prevProps.tokenValidationSuccess !== this.props?.tokenValidationSuccess) {
            this.setState({ showRsaTokenValidation: false });
            this.setState({ showRsaSuccess: true });
        }

        if (prevProps.prebackOrderDetails != this.props.prebackOrderDetails && Object.keys(this.props.prebackOrderDetails).length > 0) {
            this.setState({
                showPrebackOrderDetails: true,
            });
        }

        if (prevProps.cancelPrebackOrderStatus !== this.props.cancelPrebackOrderStatus && this.props.cancelPrebackOrderStatus?.resultList?.length > 0) {
            this.setState((prevState) => ({ cancelConfirmationOrders: [...prevState.cancelConfirmationOrders, ...this.props.cancelPrebackOrderStatus?.resultList] }));
        }
    }

    resetState = () => {
        this.setState({
            isBelow: false,
        });
    };
    handleSearchBy = (event) => {
        sessionStorage.setItem('orderSearchBy', event.target.value);
        const value = event.target.value;
        this.props.resetOrder();
        this.props.setSalesRepOrderDetails();
        this.handleCleanStates();
        this.setState({
            searchBy: value,
            uswin: this.props.userId,
            setStyle: 'uswin',
            usWinDateError: { isFromDate: false, isToDate: false, message: '' },
            uswinLocation: '',
            showLocationDetails: false,
            showRsaTokenValidation: false,
            showComboOrder: false,
            showSearchResults: false,
            showPrebackOrderDetails: false,
            showRsaSuccess: false,
            showOrderDetails: false,
        });
        if (value === 'Sales ID') {
            this.setState({ isDisable: false });
        } else if (/last\/business name/i.test(value)) {
            this.setState({ isDisable: true });
        }
    };

    handleUswinDateSelection = (type, date) => {
        const { toDate, fromDate } = this.state;
        if (type === 'toDate') {
            if (fromDate && moment(date).toDate() > moment(fromDate).add(15, 'days').toDate()) {
                this.setState({ toDate: date, isDisable: true, usWinDateError: { isFromDate: false, isToDate: true, message: 'To Date should not be grater than 15 days from From Date' } });
            } else {
                this.setState({ toDate: date, isDisable: false, usWinDateError: { isFromDate: false, isToDate: false, message: '' } });
            }
        } else {
            if (toDate && moment(date).toDate() < moment(toDate).subtract(15, 'days').toDate()) {
                this.setState({ fromDate: date, isDisable: true, usWinDateError: { isFromDate: true, isToDate: false, message: 'From Date should  be less than 15 days from to Date' } });
            } else {
                this.setState({ fromDate: date, isDisable: false, usWinDateError: { isFromDate: false, isToDate: false, message: '' } });
            }
        }
    };

    handleCustomerIdChange = (value) => {
        this.setState({ customerId: value, isDisable: !(value?.length > 0 || this.state.subAcctNum?.length > 0) });
    };

    handleSubAccountNoChange = (value) => {
        this.setState({ subAcctNum: value, isDisable: !(value?.length > 0 || this.state.customerId?.length > 0) });
    };

    handleLastNameChange = (lastName) => {
        this.setState({
            lastName,
            isDisable: !(lastName?.length > 0 || this.state.uswinLocation?.length > 0),
        });
    };
    handleLocationChange = (uswinLocation) => {
        this.setState({
            uswinLocation: uswinLocation.toUpperCase(),
            isDisable: !(uswinLocation?.length > 0 || this.state.lastName?.length > 0),
        });
    };
    //below method is not in use so commenting
    // handleGlobalLocationOnChange = () => {
    //     this.setState({
    //         orderLocationTabClicked: false,
    //         showRsaTokenValidation: false,
    //     });
    //     this.props.resetTokenValidationMessages();
    // };

    handleShowComboOrder = () => {
        this.setState((prevState) => ({
            showComboOrder: !prevState.showComboOrder,
        }));
    };

    //handlers for order number ,location code change(for combo order as well)
    handleOrderNumberChange = (value, param) =>
        param === 'orderNumber'
            ? this.setState({
                  orderNumber: value,
                  isDisable: !(value?.length > 0 || this.state.uswinLocation?.length > 0),
              })
            : this.setState({
                  orderNumber2: value,
              });

    handleLocationCodeChange = (value, param) =>
        param === 'locationCode'
            ? this.setState({
                  locationClear: false,
                  uswinLocation: value.toUpperCase(),
                  isDisable: !(value?.length > 0 || this.state.orderNumber?.length > 0 || this.state.appNum?.length > 0),
              })
            : this.setState({
                  locationClear: false,
                  locationCode2: value.toUpperCase(),
              });

    handleAppNumChange = (value) => {
        this.setState({
            appNum: value,
            isDisable: !((value && value.length > 0) || this.state.uswinLocation?.length > 0),
        });
    };

    shouldShowGlobalLocation = ({ rsaEnabled, locationType, retexMaidInd, locationSubType, masterAgentId }) => {
        return (
            this.props.isCoreRep &&
            ((locationType === 'I' && rsaEnabled === 'Y') || (locationSubType === 'GN' && masterAgentId !== null) || (locationType === 'I' && rsaEnabled === 'N' && retexMaidInd === 'Y'))
        );
    };

    handleLocationKeyDown = (e) => {
        if (this.state.uswinLocation.length === 7 && this.state.previousUswinLocation != this.state.uswinLocation) {
            const payload = {
                locationCode: this.state.uswinLocation,
                cwtDataNeeded: false,
                retrieveMsoId: false,
            };
            this.setState({ orderLocationTabClicked: true });

            this.props.getGlobalLocationDetails(payload);
            this.handleShowLocationDetails();
        }
    };

    handleSetState = (values) => {
        this.setState(values);
    };

    handleConfirmationNoChange = (e) => {
        const value = e.target.value;

        this.setState({
            confirmationNo: value,
            isDisable: value.length > 0 && isNumeric(value) ? false : true,
        });
    };

    handleConfirmationNoTwoChange = (e) => {
        const value = e.target.value;

        this.setState({
