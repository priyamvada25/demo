    handleCleanStates = () => {
        // cleaning Initial state object is declared in constants file
        this.setState({ ...cleanInitialState, clearState: Date.now() });
        this.setState({ showSearchResults: false });
        this.setState({ showRsaSuccess: false });
    };
    updateSearchCriteria = (searchCriteria) => {
        sessionStorage.setItem('searchCriteria', JSON.stringify(searchCriteria));
    };
    getSearchCriteria = () => {
        //for ACSS debugging
        console.log(sessionStorage.getItem('loadSearchCriteria'));
        if (sessionStorage.getItem('loadSearchCriteria') === 'true') {
            console.log('inside getSearchCriteria');
            this.setState({ disableSearchBtn: true });
        }
        return sessionStorage.getItem('loadSearchCriteria') === 'true' ? JSON.parse(sessionStorage.getItem('searchCriteria')) || {} : {};
    };
    removeSearchCriteria = () => {
        sessionStorage.removeItem('loadSearchCriteria');
    };
    handleClearButton() {
        this.handleCleanStates();
        this.props.resetOrder();
        sessionStorage.removeItem('loadSearchCriteria');
        sessionStorage.removeItem('searchCriteria');
        if (this.state.searchBy === 'USWIN/Date') {
            this.setState({
                // no change to uswin state value for D2D, should always remain as rep cannot edit
                isDisable: this.props.userId.length === 0 ? false : true,
            });
        }

        if (this.state.showRemarks) {
            this.setState({ showRemarks: false });
        }

        if (this.state.showOrderPreview) {
            this.setState({ showOrderPreview: false });
        }

        if (this.state.showPrebackOrderDetails) {
            this.setState({ showPrebackOrderDetails: false });
        }

        if (this.state.searchBy === 'Order') {
            this.setState({
                locationCode: this.props.userLocationCode,
                locationClear: true,
                orderNumber2: '',
                locationCode2: '',
                fromDate: getDateFormat(moment().subtract(1, 'months').toDate()),
                isDisable: true,
                lastName: '',
                uswinLocation: '',
            });
        }
        if (/sales id/i.test(this.state.searchBy)) {
            this.setState({
                isDisable: false,
            });
            this.props.setSalesRepOrderDetails();
        }
    }

    handleClickEvent = (pageNum = 1) => {
        this.props.clearErrors();
        this.props.resetOrder();
        this.props.prebackReset();
        const type = this.state.searchBy;
        this.handleUpdatePagination(pageNum);
        if (isNullOrEmpty(this.props.globalLocation?.locationType)) {
            this.handleLocationKeyDown();
        }

        if (this.state.showRemarks) {
            this.setState({ showRemarks: false });
        }
        if (this.state.showPrebackOrderDetails) {
            this.setState({ showPrebackOrderDetails: false });
        }

        if (this.state.showRsaSuccess) {
            this.setState({ showRsaSuccess: false });
        }

        if ((this.props?.globalLocation?.locationType === 'I' || this.props.globalLocation?.locationSubType === 'GN') && this.props.isCoreRep && isNullOrEmpty(this.props?.tokenValidationSuccess)) {
            this.setState({ showRsaTokenValidation: true });
        }

        Trace.tracePageAction('LpSearch', { OrderSearch: type });

        this.setState({
            selectedRow: undefined,
            showResults: true,
            orderTableScrollY: 0,
            showSearchResults: true,
            showOrderPreview: false,
            showOrderDetails: true,
        });

        const searchCriteria = {
            searchBy: type,
            ...(type === 'Order' && { searchOrderBy: this.state.searchOrderBy }),
            criteria: {},
        };
        switch (type) {
            case 'USWIN/Date':
                searchCriteria.criteria = {
                    uswin: this.state.uswin,
                    uswinLocation: this.state.uswinLocation,
                    fromDate: this.state.fromDate,
                    toDate: this.state.toDate,
                    orderType: this.state.orderType,
                };
                this.updateSearchCriteria(searchCriteria);
                return this.handleUswinRequest(type, pageNum);
            case 'MDN/SKU':
                searchCriteria.criteria = {
                    mdnNumber: this.state.mdnNumber,
                    skuNumber: this.state.skuNumber,
                    uswinLocation: this.state.uswinLocation,
                    fromDate: this.state.fromDate,
                    toDate: this.state.toDate,
                };
                this.updateSearchCriteria(searchCriteria);
                return this.handleMdnRequest(type);
            case 'Pre/Back order':
                searchCriteria.criteria = {
                    confirmationNo: this.state.confirmationNo,
                    confirmationNoTwo: this.state.confirmationNoTwo,
                };
                this.props.updatePreOrderCancelStatus({ preBackOrderstatus: '', resultList: [] });
                this.updateSearchCriteria(searchCriteria);
                return this.handlePrebackOrderRequest(type);
            case 'Customer ID':
                searchCriteria.criteria = {
                    customerId: this.state.customerId,
                    subAcctNum: this.state.subAcctNum,
                };
                this.updateSearchCriteria(searchCriteria);
                return this.handleCustomerIdRequest(type);
            case 'Paypal':
                searchCriteria.criteria = {
                    email: this.state.email,
                    fromDate: this.state.fromDate,
                    toDate: this.state.toDate,
                };
                this.updateSearchCriteria(searchCriteria);
                return this.handlePaypalRequest(type);
            case 'Device ID':
                searchCriteria.criteria = {
                    deviceId: this.state.deviceId,
                };
                this.updateSearchCriteria(searchCriteria);
                return this.handleDeviceRequest(type);
            case 'Credit card number':
                searchCriteria.criteria = {
                    amount: this.state.payment,
                    endDate: this.formatCreditCardDate(this.state.toDate),
                    startDate: this.formatCreditCardDate(this.state.fromDate),
                    ccNumber: this.state.creditNo?.trim(),
                    locationCode: this.state.locationTreasury ? this.state.locationTreasury : this.props.userLocationCode,
                    authCode: this.state.ccAuth ? this.state.ccAuth : '',
                    transId: this.state.transID ? this.state.transID : '',
                    ptaSearch: !isNumAndStar(this.state.creditNo?.trim()),
                };
                this.updateSearchCriteria(searchCriteria);
                return this.handleCreditCardRequest(type);
            case 'Internet order':
                return this.handleInternetOrderRequest(type);
            case 'DigitalCart':
                searchCriteria.criteria = {
                    cartId: this.state.simplifiedCartId,
                    fromMyBiz: true,
                };
                this.updateSearchCriteria(searchCriteria);
                return this.handleDigitalCartRequest(type);
            case 'Order':
                switch (this.state.searchOrderBy) {
                    case 'Application no':
                        searchCriteria.criteria = {
                            appNum: this.state.appNum,
                            uswinLocation: this.state.uswinLocation,
                        };
                        this.updateSearchCriteria(searchCriteria);
                        return this.handleAppNumberRequest(type);
                    case 'Last/Business name':
                        searchCriteria.criteria = {
                            lastName: this.state.lastName,
                            uswinLocation: this.state.uswinLocation,
                            fromDate: this.state.fromDate,
                            toDate: this.state.toDate,
                            orderType: this.state.orderType,
                        };
                        this.updateSearchCriteria(searchCriteria);
                        return this.handleLastNameRequest(this.state.searchOrderBy, pageNum);
                    default:
                        //default: 'Order number':
                        searchCriteria.criteria = {
                            orderNumber: this.state.orderNumber,
                            orderNumber2: this.state.orderNumber2,
                            uswinLocation: this.state.uswinLocation,
                            locationCode2: this.state.locationCode2,
                        };
                        this.updateSearchCriteria(searchCriteria);
                        return this.handleOrderRequest(type, true);
                }
            default:
                return this.handleOrderRequest(type);
        }
    };

    handleUpdatePagination = (pageNumber) => {
        this.setState({
            pageValue: pageNumber,
        });
    };

    handleLastNameRequest(type, pageNum = 1) {
        const lastNameRequest = {
            locationCode: this.state.uswinLocation.trim(),
            lastName: this.state.lastName.toUpperCase(),
            orderType: this.state.orderType,
            orderStatus: this.state.statusType === 'All' ? '' : this.state.statusType,
            fromOrderDate: this.state.fromDate,
            toOrderDate: this.state.toDate,
            pageNum,
        };
        this.props.loadOrders(lastNameRequest, type);
    }

    handleCustomerIdRequest(type) {
        const { customerId, subAcctNum } = this.state;
        //checks for the input length,iflength is 9 ad first digit is not zero ,append a zero
        let custId = customerId;
        if (!!customerId && customerId.length === 9) {
            custId = customerId.match(/\d/)[0] !== 0 ? `0${customerId}` : customerId;
        }
        if (!custId || !subAcctNum || subAcctNum.length !== 5 || custId.length !== 10) {
            this.setState({ customerIDErr: 'Please enter a valid account number' });
        } else {
            const customerReqId = `${custId}-${subAcctNum}`;
            this.setState({ custAccountNumber: customerReqId, customerIDErr: '' });
            const request = { customerId: customerReqId, retrieveECPD: false, retrieveISPU: false, retrieveBOGO: true, retrieveLastName: false, retrieveHoldOrders: false };
            this.props.loadOrders(request, type);
        }
    }

    handleAppNumberRequest(type) {
        const appNumRequest = {
            creditAppNumber: this.state.searchOrderBy === 'Order number' ? this.state.orderNumber : this.state.appNum.trim(),
            usWin: this.state.uswin ? this.state.uswin.toLowerCase().trim() : '',
        };
        this.props.loadOrders(appNumRequest, 'Application no');
    }

    handleMdnRequest(type) {
        const mdnRequest = {
            locationCode: !this.state.isChecked ? this.state.uswinLocation.trim() : null,
            mobileNumber: this.state.mdnNumber.trim(),
            sKU: this.state.skuNumber ? String(this.state.skuNumber).toUpperCase() : '',
            createStart: this.state.fromDate,
            createEnd: this.state.toDate,
        };
        this.props.loadOrders(mdnRequest, type);
    }

    handleOrderRequest(type, loadRefundStatusFlag = false) {
        // To-Do: enforce actual location code before searching
        //modified to handle combo orders and normal orders
        const { orderNumber, orderNumber2, uswinLocation = '', locationCode2 = '' } = this.state;
        let request;
        if (this.state.showComboOrder && orderNumber2 && locationCode2) {
            if (orderNumber !== null && uswinLocation !== null) {
                request = {
                    locationCode: '',
                    orderNumber: '',
                    orderStatus: '',
                    comboOrders: [
                        {
                            locationCode: uswinLocation.toUpperCase(),
                            orderNumber: orderNumber,
                        },
                        {
                            locationCode: locationCode2.toUpperCase(),
                            orderNumber: orderNumber2,
                        },
                    ],
                };
            }
        } else {
            request = {
                locationCode: !uswinLocation ? '' : uswinLocation.toUpperCase(),
                orderNumber: orderNumber,
                comboOrders: null,
                orderStatus: this.state.statusType === 'All' ? '' : this.state.statusType,
            };
        }

        if (loadRefundStatusFlag) {
            let comboOrdersPayload = [];
            comboOrdersPayload.push({
                locationCode: uswinLocation.toUpperCase(),
                orderNum: orderNumber,
            });
            if (this.state.showComboOrder && locationCode2 && orderNumber2) {
                comboOrdersPayload.push({
                    locationCode: locationCode2 ? locationCode2.toUpperCase() : '',
                    orderNum: orderNumber2 ? orderNumber2 : '',
                });
            }
            this.props.loadOrderRefundStatusFlag({
                comboOrders: comboOrdersPayload,
            });
        }
        this.props.loadOrders(request, type);
    }

    handleUswinRequest(type, pageNum = 1) {
        const usWinVal = this.state.uswin === 'All' ? '' : this.state.uswin.toLowerCase().trim();
        const uswinRequest = {
            pageNum,
            locationCode: this.state.uswinLocation.trim(),
            orderStartDate: this.state.fromDate,
            orderEndDate: this.state.toDate,
            orderType: this.state.orderType,
            usWin: this.state.uswin ? usWinVal : '',
            // unique to b2b only
            orderStatus: this.state.statusType === 'All' ? '' : this.state.statusType,
            lastBusinessName: isEmpty(this.state.lastName) ? '' : this.state.lastName.toUpperCase(),
        };
        this.props.loadOrders(uswinRequest, type);
    }

    handlePaypalRequest(type) {
        if (this.state.email && !this.state.fromDate && !this.state.toDate) {
            const request1 = {
                emailId: this.state.email,
            };
            this.props.loadOrders(request1, type);
        } else {
            const request2 = {
                emailId: this.state.email,
                orderStartDate: this.state.fromDate,
                orderEndDate: this.state.toDate,
            };
            this.props.loadOrders(request2, type);
        }
    }

    handleDeviceRequest(type) {
        const request = {
            locationCode: '',
            deviceid: this.state.deviceId?.trim(),
        };
        this.props.loadOrders(request, type);
    }

    formatCreditCardDate = (dateValue) => {
        return moment(new Date(dateValue)).format('DD-MMM-YYYY');
    };

    //credit card search/pta token
    handleCreditCardRequest(type) {
        //error handling for credit card location search if required field not available
        if (!isEmpty(this.state.locationTreasury) && this.state.creditNo.length < 1 && this.state.ccAuth.length < 1 && this.state.transID.length < 1 && this.state.payment.length < 1) {
            //set error state to true
            this.setState({
                locationErr: true,
            });
        } else {
            const creditCardRequest = {
                amount: this.state.payment,
                endDate: this.formatCreditCardDate(this.state.toDate),
                startDate: this.formatCreditCardDate(this.state.fromDate),
                ccNumber: this.state.creditNo?.trim(),
                locationCode: this.state.locationTreasury ? this.state.locationTreasury : this.props.userLocationCode,
                authCode: this.state.ccAuth ? this.state.ccAuth : '',
                transId: this.state.transID ? this.state.transID : '',
                ptaSearch: !isNumAndStar(this.state.creditNo?.trim()),
            };
            //set error state to false and make api call
            this.setState({
                locationErr: false,
            });
            this.props.loadOrders(creditCardRequest, type);
        }
    }

    handleInternetOrderRequest(type) {
        const internetOrderRequest = {
            locationCode: this.props.userLocationCode,
            cisOrderNumber: this.state.cisNo?.trim(),
            confirmationNumber: this.state.confirmationNo?.trim(),
            lastBusinessName: this.state.lastName?.trim(),
        };
        if (this.state.internetOrdersType === 'Date' || this.state.internetOrdersType === 'Last/Business name') {
            internetOrderRequest['fromOrderDate'] = getDateFormat(this.state.fromDate);
            internetOrderRequest['toOrderDate'] = getDateFormat(this.state.toDate);
        }
        this.props.loadOrders(internetOrderRequest, type);
    }

    handleDigitalCartRequest(type) {
        let request = {
            cartId: this.state.simplifiedCartId,
            fromMyBiz: true,
        };
        this.props.loadOrders(request, type);
    }

    handlePrebackOrderRequest(type, pageNum = 1) {
        const prebackOrderRequest = {
            locationCode: this.state.uswinLocation,
            applicationNumber: this.state.applicationNo.trim(),
            confirmationNumberList: [this.state.confirmationNo.trim(), this.state.confirmationNoTwo.trim()].filter((e) => e !== ''),
            orderNumber: this.state.orderNo?.trim(),
            lastBusinessName: this.state.lastName.toUpperCase(),
            pageNum: pageNum,
            useAcssPrebackUrl: true,
            searchType: 'ICONIC_ORDERS_BY_CONFIRMATION_NO',
        };
        this.props.loadOrders(prebackOrderRequest, type);
    }

    renderSearchResultsContainer = () => {
        let { order, isLoading, salesRepOrderDetails = [], totalRecords = 0, customerInfo } = this.props.order;
        const { aceOrderTelRepLocSearchDetailsList = [] } = salesRepOrderDetails;
        const { pageValue, searchBy } = this.state;

        const aceOrderTelRepLocSearchDetailsListLen = aceOrderTelRepLocSearchDetailsList ? aceOrderTelRepLocSearchDetailsList.length : 0;
        const orderLengthVal = !isEmpty(order) ? order.length : aceOrderTelRepLocSearchDetailsListLen;
        const totalRows = order && /last\/business name|uswin\/date|pre\/back order/i.test(searchBy) ? totalRecords : orderLengthVal;
        const showNoResultsAvailable = !isLoading && totalRows === 0;
        if (showNoResultsAvailable && this.state.showResults) {
            this.setState({
                showResults: false,
                isExpand: false,
                isBelow: true,
            });
        }

        return (
            <div>
                {(!this.props.isCoreRep || !(this.props.globalLocation?.locationType === 'I' && isNullOrEmpty(this.props?.tokenValidationSuccess))) &&
                (!isEmpty(order) || (!isEmpty(salesRepOrderDetails) && salesRepOrderDetails.totalCount > 0)) &&
                order?.length > 0 ? (
                    <div className="orderTable acssOrderTable" data-testid="orderTableTest" id="orderTable" onScroll={this.handleOrderSearchScroll} ref={this.orderTableRef}>
                        <OrderTable
                            order={order}
                            customerInfo={customerInfo}
                            handleViewOrder={this.handleViewOrder}
                            handleViewData={this.handleViewData}
                            handleInfoIcon={this.handleOrderInfoIcon}
                            infoIcon={this.props.order.infoIcon}
                            orderNumber={this.state.orderNumber}
                            searchBy={this.state.searchBy}
                            ptaSearchType={this.state.ptaSearchType}
                            prebackOrdersType={this.state.prebackOrdersType}
                            mdnNumber={this.state.mdnNumber}
                            location={this.state.locationCode ? this.state.locationCode : this.state.uswinLocation}
                            repId={this.state.repId}
                            pageNumber={pageValue}
                            handleSelectedIndex={(index) =>
                                this.setState({
                                    selectedRow: index,
                                })
                            }
                            handleHideButtonAndOrderNumber={this.handleHideButtonAndOrderNumber}
                            handleCIDBDelete={this.props.handleCIDBDelete}
                            CIDBItem={this.props.CIDBItem}
                            userProfileInfo={this.props.userProfileInfo}
                            selectedRow={this.state.selectedRow}
                            handleScroll={this.handleScroll}
                            loading={isLoading}
                            loadBasicMTN={this.props.loadBasicMTN}
                            basicMTNInfo={this.props.basicMTNInfo}
                            handleActivationStatusModal={this.handleActivationStatusModal}
                            handleCancelPrebackOrder={this.handleCancelPrebackOrder}
                            getCancelPreBackOrderStatus={this.getCancelPreBackOrderStatus}
                            cancelPrebackOrderStatus={this.props.cancelPrebackOrderStatus}
                            handleOrderDetails={this.handleOrderDetails}
                            serviceChange={this.props.serviceChange}
                            searchOrderBy={this.state.searchOrderBy}
                            refundFlag={this.props.refundFlag}
                            ispuFlag={this.props.ispuFlag}
                            isDark={this.isDark}
                            source={this.state.source}
                        />
                    </div>
                ) : (
                    !this.props?.error && !isLoading && this.state.showSearchResults && <p className={`acss-no-records ${this.isDark ? ' acss-cell-dark' : ''}`}>No Records found</p>
                )}
            </div>
        );
    };

    handleOrderSearchScroll = () => {
        this.setState({
            orderTableScrollY: this.orderTableRef.current.scrollTop,
        });
    };

    handleScroll = () => {
        setTimeout(() => {
            if (this.orderTableRef.current) {
                this.orderTableRef.current.scrollTop = this.state.orderTableScrollY;
            }
        }, 10);
    };

    handleOrderInfoIcon = (item) => {
        let IconRequest = {
            creditApplicationNum: item.appnumber ? `${item.appnumber.replace(/\s\w*/i, '')}` : '',
            locationCode: item.location ? item.location : locationCode,
        };
        this.props.loadOrderIcon(IconRequest);
    };

    handleHideButtonAndOrderNumber = (value, orderNumber, locationCodeValue) => {
        this.setState({
            buttonHide: value,
            orderNumber: orderNumber,
        });
    };

    handleActivationStatusModal = (locationCode) => {
        this.setState({ showActivationStatusModal: true });
        this.setState({ uswinLocation: locationCode });
    };

    handleModalClose = () => {
        this.setState({
            showModal: false,
        });
    };

    handleCancelPrebackOrder = (confNum, location) => {
        const userId = getCookie('ACSS_ROUTER_ID_NSA');

        const payload = {
            preOrderId: confNum,
            locationCode: location,
            userId: userId ? userId : 'CAREENC01',
        };
        this.props.cancelPrebackOrder(payload);
    };

    getCancelPreBackOrderStatus = (confNum) => {
        if (this.state.cancelConfirmationOrders?.length > 0 && this.state.cancelConfirmationOrders?.some((result) => result.includes(confNum))) {
            return true;
        }
        return false;
    };

    handleOrderDetails = (order) => {
        this.props.getOrderDetailsRequest(
            order.orderType,
            {
                locationCode: order.locationCode,
                orderNum: order.orderNum,
            },
            {
                locationCode: order.locationCode,
                confNum: order.confNum,
                salesRepId: order.salesRepId,
                retrievePreorderDetails: 'Y',
            }
        );
    };

    handleViewOrder = (orderNumber, location, selectedRow, mobileNumber, ptaResumeDataForJWT = null, orderTypeProp = '') => {
        // hide Live review
        if (sessionStorage.getItem('channel') === 'CHAT-STORE') {
            let hideLiveReviewBtn = window.parent; //live review
            const liveReviewEventData = {
                iframe: 'livereview',
                url: '',
                enableLiveReviewBtn: false,
            };
            hideLiveReviewBtn.postMessage(liveReviewEventData, POSTMESSAGE_ORIGIN);
        }
        const { userId, salesRepId } = this.props.userProfileInfo;
        const { userLocationCode } = this.props;
        const userLocationCodeVal = !isEmpty(userLocationCode) ? userLocationCode : sessionStorage.getItem('location');
        const locationCode = !isEmpty(location) ? location : this.state.uswinLocation ? this.state.uswinLocation : userLocationCodeVal;
        const { order, salesRepOrderDetails = [] } = this.props.order;
        const aceOrderTelRepLocSearchDetailsList = !isEmpty(salesRepOrderDetails) && salesRepOrderDetails.aceOrderTelRepLocSearchDetailsList;
        const { salesidIndex = 0 } = this.state;
        const salesRepRes = !isEmpty(aceOrderTelRepLocSearchDetailsList) && aceOrderTelRepLocSearchDetailsList[salesidIndex];
        const orderRes = !isEmpty(order) && order[selectedRow];
        const { aceOrdcartID, ecpdLiabilityType, ecpdId, cartId, nsaOrder } = salesRepRes ? salesRepRes : orderRes;
        const prepayViewOrder = !/y/i.test(nsaOrder);
        const postpayBauViewOrder = /flex/i.test(aceOrdcartID);
        const fortyFiveDaysOld = orderRes['nsaOrderNotCompletedAfterFortyFiveDays'] === true || orderRes['nsaOrderAfterFortyFiveDays'] === true;
        const orderType = !isEmpty(salesRepRes) && salesRepRes.orderType;
        const isB360Order = /b2bso_/i.test(aceOrdcartID);
        const isCleuCustomer = (!isB360Order && !isEmpty(ecpdId) && /c/i.test(ecpdLiabilityType)) || !isEmpty(cartId);
        const orderTypeId = !isEmpty(order) && order[selectedRow] && order[selectedRow].aceOrdcartID;
        const orderTypeShortDesc = get(order[selectedRow], 'orderTypeShortDesc', null);
        // First check for B360 scenarios (regardless of order type)
        if (isB360Order || (isCleuCustomer && orderTypeId !== 'MSF_QASALES')) {
            this.handleB2BOrdering(orderNumber, location);
        } else {
            const orderTypeURLVal = getApplicationRedirectUrls('carestore');
            let url = orderTypeId === 'MSF_QASALES' ? '' : orderTypeURLVal;
            url += sessionStorage.getItem('channel') || 'OMNI-RETAIL';
            if (fortyFiveDaysOld && !prepayViewOrder) {
                url += '&fortyFiveDaysOrder=true';
            }
            if (orderTypeId === 'MSF_QASALES') {
                const hostProtocol = window.location.hostname === 'localhost' ? 'https:' : window.location.protocol;
                const soe = 'soe';
                //const localHostLowerEnv = (window.location.hostname === 'localhost')?
                const channelHost = 'carestore';
                const lowerEnvURLVal = window.location.hostname === 'localhost' ? '-' + ENV_OVERRIDE_SOE() : '-nssit' + window.location.hostname.match(/[nsd|nssit|nsq]+(\d{1})/i)?.[1];
                const lowerEnv = isAcssProd() ? '' : lowerEnvURLVal;
                const hostVal = isAcssProd() ? '.vzwcorp.com' : lowerEnv + '.verizon.com';
                url = `${hostProtocol}//${channelHost}-${soe}${hostVal}${CARE_QUICKACCESSORY_PATH}`;

                const requestTypeVal = !isEmpty(order) && order[selectedRow].orderTypeShortDesc ? order[selectedRow].orderTypeShortDesc : orderType;
                const orderTypeVal = orderRes?.requestType ? orderRes.requestType : requestTypeVal;
                const qaOrderType = orderRes?.orderType ? orderRes.orderType : orderTypeVal;
                url += `&orderType=${qaOrderType}`;
            } else {
                const ordertype = isEmpty(orderTypeProp) && !isEmpty(order) && order[selectedRow].orderTypeShortDesc ? order[selectedRow].orderTypeShortDesc : orderTypeProp;
                url += `&orderType=${ordertype}`;
            }

            // Send this flag to read order for resuming PTA orders.
            if (!isEmpty(ptaResumeDataForJWT)) {
                url += `&isPaxResume=true`;
            }

            url += `&LocationCode=${locationCode}`;
            url += `&orderLocationCode=${locationCode}`;
            url += `&orderNumber=${orderNumber}`;

            url += '&locationType=S';
            url += `&salesRep=${salesRepId}`;
            url += `&loggedInUser=${userId}`;
            url += `&locationCode=${locationCode}`;
            if (!isEmpty(this.props.interactionCaseId) && this.props.IITSShippingAddEnable === 'Y' && !isEmpty(this.props.acssBaseURL)) {
                const acssEncodeBaseURL = encodeURIComponent(this.props.acssBaseURL);
                url += `&InteractionCaseId=${this.props.interactionCaseId}`;
                url += `&IITSShippingAddEnable=${this.props.IITSShippingAddEnable}`;
                url += `&acssBaseURL=${acssEncodeBaseURL}`;
            }
            url += `&isB360Order=${isB360Order}`;

            this.props.setCookieRequest({ orderNumber, locationCode, url, mobileNumber, ptaResumeDataForJWT, orderTypeId });
        }
    };

    handleB2BOrdering = (order, location) => {
        const request = {
            locationCode: location,
            orderNumber: order,
            b360Order: true,
            retrieveISPU: false,
            retrieveBOGO: true,
            retrieveLastName: false,
            orderStatus: '',
        };
        var order = {};
        try {
            this.props.loadOrders(request, 'Order', '');
        } catch (httpError) {
            console.error('LOG-DEBUG: App -> Read Order -> Error while read-order-details', httpError);
        }
    };

    render() {
        const { searchBy, isBelow } = this.state;
        const { order } = this.props.order;
        const isLoading = this.props.isLoading || this.props.isOrderRemarksLoading || this.props.isSetCookieLoading;

        let { deviceId = '', orderNum = '', ordStatus = '' } = order?.[0] ?? {};
        const confNumVal = this.props.order?.order && this.props.order?.order.length > 0 ? this.props.order?.order[0]?.confNum : '';
        const remarks = this.props.remarkDetails?.remark?.length === 0 ? this.state.noRemarks : this.props.remarkDetails?.remark;
        const tableHeaders = ['Line', 'MTN', 'Date', 'Carrier_Tracking_Number', 'Status'];
        const shouldDisableSearch =
            this.props.orderSearchParams?.orderNumber?.length > 0 || this.props.orderSearchParams?.confirmationNumber?.length > 0 || this.state.disableSearchBtn ? false : this.state.isDisable;
        return (
            <Suspense fallback={null}>
                {isLoading && <Loader active />}

                <div
                    id="orderSearchContainer"
                    className={`SearchTopContainer${isBelow ? ' below' : ''} ${this.isDark ? 'search-container-dark' : ''}`}
                    onClick={() => {
                        this.resetState();
                    }}
                    data-testid="reset">
                    {this.props.isCoreRep && <AcssSelectApplication globalLocation={this.props.globalLocation || {}} orderNumber={this.state.orderNumber} isDark={this.isDark} />}
                    <div className={this.isDark ? 'SearchOptions acss-dark-theme' : 'SearchOptions order-search-wrapper'}>
                        <div className="SearchOption">
                            <div className="SearchOptionsCol">
                                <div className="orderDropdownStyle">
                                    <Label>Search by</Label>
                                    <DropdownSelect
                                        ariaLabel={`Search by ${searchBy}`}
                                        data-testid="order"
                                        name="type"
                                        role="combobox"
                                        placeholder={searchBy}
                                        error={false}
                                        value={searchBy}
                                        onChange={(event) => this.handleSearchBy(event)}>
                                        {(this.props.isInsideSalesUser ? InsideSalesOrderSearchList : AcssOrderSearchList).map((category) => {
                                            return <option value={category.value}>{category.label}</option>;
                                        })}
                                    </DropdownSelect>
                                </div>
                            </div>
                            {this.handleRenderSearchBy(searchBy)}
                        </div>
                        <div>
                            {this.state.showLocationDetails && (
                                <div data-testid="checkDark" className={this.isDark ? 'acss-no-records acss-cell-dark' : 'acss-no-records'}>
                                    <div className="location-margin">
                                        <b>Location Type:</b> {this.props.globalLocation?.locationType}
                                    </div>
                                    <div className="location-margin">
                                        <b>Location Name:</b> {this.props.globalLocation?.locationName}
                                    </div>
                                    <div className="location-margin">
                                        <b>Billing Outlet ID:</b> {this.props.globalLocation?.activatingAgent}
                                    </div>
                                </div>
                            )}
                        </div>
                        <div className="SearchOption"></div>
                        <div className="Buttons">
                            <div>
                                <Button
                                    className={`${this.isDark && shouldDisableSearch ? ' search-dark-disabled' : 'SearchButton'}`}
                                    data-track="search-order"
                                    disabled={shouldDisableSearch}
                                    onClick={() => {
                                        this.handleClickEvent();
                                    }}
                                    data-testid="search">
                                    {'Search'}
                                </Button>
                            </div>
                            <div>
                                <Button
                                    secondary
                                    className={`${this.isDark && shouldDisableSearch ? ' clear-dark-disabled' : 'ClearButton'}`}
                                    data-track="clear-order-search"
                                    onClick={this.handleClearButton}
                                    disabled={shouldDisableSearch}
                                    data-testid="clear">
                                    {'Clear'}
                                </Button>
                            </div>
                        </div>
                    </div>

                    {this.state.showRemarks && (
                        <div className={`remarks-scroll ${this.isDark ? ' acss-dark-theme remarks-scroll-dark' : ''}`}>
                            <div className="remarks-header-align acss">
                                <div>Remarks</div>
                                <div className="remarks-header">
                                    <Button onClick={() => this.handleViewData('remarks')} color={this.isDark ? 'white' : 'black'} data-testid="validate">
                                        Close remarks
                                    </Button>
                                </div>
                                <span onClick={() => this.handleViewData('remarks')}>
                                    <Icon name="close" color={this.isDark ? 'white' : 'black'} style={{ height: '2rem', width: '2rem' }} class="icon" size="extraLarge" />
                                </span>
                            </div>
                            {remarks && <OrderRemarksInfo remarkDetails={remarks} carrierTrackingInfo={this.props.carrierTrackingInfo} />}
                            <Button className="trackItButton" onClick={() => this.showTrackShipment()} style={{ display: 'flex' }}>
                                {'Track Shipment'}
                            </Button>
                            {this.state.showFFLTrackingInfo && (
                                <Table className="OrderRemarksInfoTable">
                                    <TableHead className="OrderRemarksInfoTableHeader">
                                        {tableHeaders.map((item, index) => {
                                            return (
                                                <TableHeader className="tableHeader" key={`${index}`}>
                                                    {item}
                                                </TableHeader>
                                            );
                                        })}
                                    </TableHead>
                                    <TableBody className="OrderRemarksInfoTableBody">
                                        {this.props.carrierTrackingInfo?.length > 0 ? (
                                            this.props.carrierTrackingInfo?.map((item, index) => {
                                                const mtn = item?.mobileNumber,
                                                    shipDate = item?.fflTrackingDetails?.shipDate,
                                                    trackingNo = item?.fflTrackingDetails?.trackingNumber,
                                                    carrier = item?.fflTrackingDetails?.shippingCarrier;
                                                return item !== null ? (
                                                    <TableRow key={`${index}`} className="OrderRemarksInfoTableRow">
                                                        <Cell>{index + 1}</Cell>
                                                        <Cell>{mtn}</Cell>
                                                        <Cell>{shipDate ? shipDate?.slice(0, 2) + '/' + shipDate?.slice(2, 4) + '/' + shipDate?.slice(4, 8) : ''}</Cell>
                                                        <Cell>{this.buildTrackingNumberUrl(carrier, trackingNo)}</Cell>
                                                        <Cell>{!(shipDate && trackingNo) ? 'Shipment request not received' : shipDate ? 'SENT' : trackingNo ? 'SHIPPED' : ''}</Cell>
                                                    </TableRow>
                                                ) : (
                                                    <TableRow key={index} className="OrderRemarksInfoTableRow">
                                                        <Cell>{index + 1}</Cell>
                                                        <Cell></Cell>
                                                        <Cell></Cell>
                                                        <Cell></Cell>
                                                        <Cell>{'Shipment request not received'}</Cell>
                                                    </TableRow>
                                                );
                                            })
                                        ) : (
                                            <TableRow key={`0`} className="OrderRemarksInfoTableRow">
                                                <Cell>{'1'}</Cell>
                                                <Cell></Cell>
                                                <Cell></Cell>
                                                <Cell></Cell>
                                                <Cell>{'Shipment request not received'}</Cell>
                                            </TableRow>
                                        )}
                                    </TableBody>
                                </Table>
                            )}
                        </div>
                    )}
                    {this.state.showRsaTokenValidation && this.props.isCoreRep && (
                        <>
                            <GlobalLocationRsaToken
                                globalLocation={this.props.globalLocation || {}}
                                isCoreRep={this.props.isCoreRep}
                                isDark={this.isDark}
                                handleViewData={(index) => this.handleViewData(index)}
                            />
                        </>
                    )}

                    {this.state.showRsaSuccess && this.props.isCoreRep && (
                        <>
                            <div className={this.isDark ? 'acss-dark-theme' : ''}>
                                <div className="acss remarks-header-align">
                                    <div>Validate Token Results</div>
                                    <span onClick={() => this.handleViewData('rsaTokenSuccess')} data-testid="rsaTokenSuccess">
                                        <Icon name="close" style="margin-right:200px" color={this.isDark ? 'white' : 'black'} class="icon" size="extraLarge" />
                                    </span>
                                </div>
                                <div className="rsa-token-results">
                                    <p>Result : {this.props?.tokenValidationSuccess?.rsaTokenDetails}</p>
                                    <p>Credential Type :{this.props?.tokenValidationSuccess?.credentialType} </p>
                                    <p>AuthenticatioID : {sessionStorage.getItem('successAuthenticationID')}</p>
                                    <p>Token : {this.props?.tokenValidationSuccess?.rsaToken}</p>
                                    <p>UserId : {this.props?.tokenValidationSuccess?.appUserId}</p>
                                    <p>Last Name : {this.props?.tokenValidationSuccess?.lastName}</p>
                                    <p>First Name : {this.props?.tokenValidationSuccess?.firstName}</p>
                                    <p>Location Code : {this.props?.tokenValidationSuccess?.locationCode}</p>
                                    <p>Location Name : {this.props?.tokenValidationSuccess?.locationName}</p>
                                    <a onClick={() => this.handleViewData('rsaTokenSuccess')} style={{ fontSize: '20px' }}>
                                        Clear Results
                                    </a>
                                </div>
                            </div>
                        </>
                    )}
                    {this.state.showSearchResults && this.state.showOrderDetails && !this.state.showRsaTokenValidation && this.renderSearchResultsContainer()}
                    {!this.state.showRsaTokenValidation && this.state.showOrderPreview && (
                        <div>
                            <div className={`acss ${this.isDark ? ' remarks-header-align-dark' : ' remarks-header-align'}`}>
                                <div className="remarks-header">
                                    <Button onClick={() => this.handleViewData('orderPreview')} data-testid="validate">
                                        Close Preview
                                    </Button>
                                </div>
                                <span onClick={() => this.handleViewData('orderPreview')}>
                                    <Icon name="close" color={this.isDark ? 'white' : 'black'} class="icon" size="extraLarge" />
                                </span>
                            </div>
                            {this.props.remarkDetails && (
                                <AcssGenericOrderPreview
                                    showOnlyOrderPreviewTab
                                    location={
                                        (this.state.selectedRow > -1 && this.props?.order?.order?.[this.state.selectedRow]?.locationCode) ||
                                        this.props?.order?.order?.[this.state.selectedRow]?.orderLocation ||
                                        this.props?.order?.order?.[this.state.selectedRow]?.aceOrdLocationCode ||
                                        this.state.uswinLocation
                                    }
                                    orderNumber={(this.state.selectedRow > -1 && this.props?.order?.order?.[this.state.selectedRow].orderNumber) || this.state.orderNumber}
                                    searchType={this.state.searchBy}
                                    handleOrderSearchPreview={() => {}}
                                    selectedRow={this.state.selectedRow}
                                    isDark={this.isDark}
                                />
                            )}
                        </div>
                    )}
                    {this.state.showActivationStatusModal && (
                        <ActivationStatusModal
                            show={this.state.showActivationStatusModal}
                            closeButton={(value) => {
                                if (!value) this.setState({ showActivationStatusModal: false });
                            }}
                            locationCode={this.state?.uswinLocation || this.props.uswinLocation}
                            orderNum={this.state.orderNumber}
                            retrieveDetailedStatus={false}
                            isDark={this.isDark}
                        />
                    )}
                    {this.state.showPrebackOrderDetails && (
                        <div className={this.isDark ? 'acss-dark-theme' : ''}>
                            <div className="remarks-header-align acss">
                                <div>Pre Order Details</div>
                                <span onClick={() => this.handleViewData('preorderdetails')}>
                                    <Icon name="close" color={this.isDark ? 'white' : 'black'} class="icon" size="extraLarge" />
                                </span>
                            </div>
                            (
                            <PreBackOrderPreview
                                orderPreview={{
                                    orderPreviewObj: this.props.prebackOrderDetails?.orderDetails || {},
                                }}
                                orderDetailsKey="Acss PreBack Order Details"
                                featureList={this.props.prebackOrderDetails?.featurePlans || {}}
                                channel={ACSS_ORDER_SEARCH_CHANNEL}
                            />
                            ){' '}
                        </div>
                    )}
                </div>

                <Modal
                    ariaLabel="Modify Payment"
                    className="lp-modal fullscreen modify-payment"
                    opened={!!this.state.showModal}
                    closeButton={
                        <div className="closebtn-container preback">
                            <Icon name="close" size={23} />
                        </div>
                    }
                    onOpenedChange={(value) => {
                        if (!value) {
                            this.setState({ showModal: value });
                        }
                    }}>
                    <ModalTitle>Decline offer</ModalTitle>
                    <ModalTitle>Modify payment</ModalTitle>
                    <ModalBody>
                        <PrebackCancel
                            searchType={this.state.searchBy}
                            userId={this.props.userId}
                            locationCode={this.props.userLocationCode}
                            deviceId={deviceId}
                            orderNum={orderNum}
                            ordStatus={ordStatus}
                            confirmationNum={this.state.confirmationNo ? this.state.confirmationNo : confNumVal}
                            handleModalClose={this.handleModalClose}
                        />
                    </ModalBody>
                </Modal>
            </Suspense>
        );
    }
}
const mapStateToProps = createStructuredSelector({
    prebackOrderDetails: getPrebackOrderDetails(),
});

export const mapDispatchToProps = (dispatch) => ({
    getOrderDetailsRequest: (orderType, completeOrderPayload, readCartPayload) => dispatch(getOrderDetailsRequest(orderType, completeOrderPayload, readCartPayload)),
    updatePreOrderCancelStatus: (payload) => dispatch(setCancelPrebackOrderSuccess(payload)),
});

const withConnect = connect(mapStateToProps, mapDispatchToProps);

export default compose(withConnect)(AcssOrderSearch);
